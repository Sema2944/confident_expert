BOT_TOKEN=
# Мессенджер MAX (отдельный сервис: python -m bot_max.max_main)
MAX_BOT_TOKEN=
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1792
MAX_ITEMS_PER_USER=60
RATE_LIMIT_UPLOAD_PER_MIN=10
LOG_LEVEL=INFO
ADMIN_ID=0
WARDROBE_STORAGE_PATH=./data/wardrobe.sqlite3
STT_API_KEY=
FASHION_TREND_FEEDS=

# Фото вещей в объектном хранилище. Пустые ключи — бот работает без S3.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=shkaf-rabotaet
S3_ENDPOINT=https://storage.yandexcloud.net

# webhook — как на Render (нужен WEBHOOK_BASE). polling — long polling на VPS.
# В обоих режимах процесс слушает PORT внутри контейнера: / и /yookassa/webhook.
TG_MODE=webhook
WEBHOOK_BASE=
WEBHOOK_PATH=/tg/webhook
WEBHOOK_SECRET=
PORT=10000

# Имя проекта docker-compose 1.29.2, чтобы контейнеры не смешались с чужими.
COMPOSE_PROJECT_NAME=shkaf
# Порт на самом сервере, только 127.0.0.1. 10000 на VPS уже занят.
HOST_PORT=8095

# Postgres. Если оба пустые — SQLite по WARDROBE_STORAGE_PATH.
# DB_URL важнее DATABASE_URL. Пароль в лог не пишется.
DB_URL=
DATABASE_URL=

# FSM. Пусто — память процесса. Для нескольких процессов: redis://host:6379/0
REDIS_URL=

# Только для docker-compose на VPS. Порт Postgres на хост не пробрасывается.
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=
POSTGRES_DB=wardrobe

# Посты в канал @shkaf_rabotaet. По умолчанию выключено:
# не сеять расписание и не запускать цикл канала.
# На Render без PostgreSQL (DB_URL) SQLite пропадает при рестарте.
# Даже при true посты старше 30 минут, которые ещё не уходили, не публикуются.
CHANNEL_AUTOPOST_ENABLED=false

# Утренние образы, paywall follow-up и отчёт админу в 21:00.
# Не зависит от CHANNEL_AUTOPOST_ENABLED. По умолчанию включено.
# Повтор той же рассылки в тот же день блокируется записью в БД.
USER_SCHEDULER_ENABLED=true

# ЮKassa. Автосписания нет: каждый период оплачивается вручную.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/wardrobe_24_bot
# true: вебхук принимается только с IP ЮKassa (X-Forwarded-For или прямой адрес).
YOOKASSA_IP_CHECK=true

# Клуб «Шкаф работает»
CLUB_PRICE_RUB=990
CLUB_PERIOD_DAYS=30
TRIAL_PRICE_RUB=1
TRIAL_DAYS=3
# Первые INTRO_MEMBER_LIMIT платящих: INTRO_PRICE_RUB первые INTRO_MONTHS месяца, затем CLUB_PRICE_RUB.
INTRO_PRICE_RUB=690
INTRO_MEMBER_LIMIT=50
INTRO_MONTHS=3

# Admitad
ADMITAD_UID=
# Admitad API token (опционально) – для партнёрских ссылок
ADMITAD_API_TOKEN=

# Двухуровневая генерация: Replicate (дешёвый для free) + OpenAI (премиум)
# Без REPLICATE_API_TOKEN → все через OpenAI (как раньше)
REPLICATE_API_TOKEN=
