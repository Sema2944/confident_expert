BOT_TOKEN=
# Мессенджер MAX (отдельный сервис: python -m bot_max.max_main)
MAX_BOT_TOKEN=
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1792
MAX_ITEMS_PER_USER=60
RATE_LIMIT_UPLOAD_PER_MIN=10
LOG_LEVEL=INFO
WARDROBE_STORAGE_PATH=./data/wardrobe.sqlite3

# Webhook mode (опционально)
WEBHOOK_BASE=
WEBHOOK_PATH=/tg/webhook
WEBHOOK_SECRET=
PORT=10000

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/wardrobe_24_bot

# Admitad
ADMITAD_UID=
# Admitad API token (опционально) – для партнёрских ссылок
ADMITAD_API_TOKEN=

# Двухуровневая генерация: Replicate (дешёвый для free) + OpenAI (премиум)
# Без REPLICATE_API_TOKEN → все через OpenAI (как раньше)
REPLICATE_API_TOKEN=
